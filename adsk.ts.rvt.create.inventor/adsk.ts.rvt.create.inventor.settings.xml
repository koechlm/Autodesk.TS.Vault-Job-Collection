<?xml version="1.0" encoding="utf-8" ?>
<settings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Logfile directory; validate for write access -->
  <LogFileLocation>C:\Temp\</LogFileLocation>

  <!-- Allow the reuse of an existing IPJ file if the download of it fails; accepted values are True/False-->
  <AcceptLocalIpj>True</AcceptLocalIpj>

  <!-- Restrict job execution to transmitted file version. Set to False if a predecessor job synchronizes properties. -->
  <EnforceSubmittedFileVersion>False</EnforceSubmittedFileVersion>
  
  <!-- Use Inventor.exe consuming a license; accepted values are True/False, default is False and leverages VaultInventorServer -->
  <UseInventorExe>False</UseInventorExe>

  <!-- Export File Format(s)-->
  <!--  Supported Values/File Formats are: RVT -->
  <ExportFormats>RVT</ExportFormats>

  <!-- enable/disable Revit Updating; default is False, as Vault Automation secures associativity -->
  <RvtAssociative>False</RvtAssociative>
  
  <!-- Target Revit version(s); comma-separated for multiple outputs, e.g. 2026, 2027. Each version must be installed on the Job Processor machine -->
  <TargetRevitVersion>2027</TargetRevitVersion>
  
  <!-- Revit Template (*.rte) file location as Vault path, e.g., $/Templates/Revit/RevitExportTemplate.rte; leave empty to consume default template. -->
  <!-- Note: Ensure the template file version format matches the minimum target Revit version, e.g. 2026 to be consumed by 2026 and 2027. -->
  <RevitTemplate></RevitTemplate>

  <!-- RVT preset: store a Vault path of the Inventor preset file, e.g. $/Templates/Inventor/Presest/SimplifyCmd.preset-->
  <InventorPreset>$/Templates/Inventor/Presets/SimplifyCmd.preset</InventorPreset>

  <!-- RVT preset name(s); comma-separated for multiple outputs per Revit version, e.g. RVT_Level_1, RVT_Level_2.  -->
  <InventorPresetName>RVT_Level_2</InventorPresetName>

  <!-- Copy source file's system comment; accepted values are True/False -->
  <CopySystemComment>True</CopySystemComment>

  <!-- Export destination. Leave empty to export next to the source file. -->
  <!-- Absolute:   $/Designs/Revit Exports -->
  <!-- Relative up:    ..\Revit Export  or  ..\..\Revit Export  (.. = one level up per segment) -->
  <!-- Relative down:  Revit Export  (subfolder under the source file's folder) -->
  <ExportPath></ExportPath>

  <!-- Output Path -->
  <!--  The job can copy the resulting file(s) to the given output path after check-in-->
  <OutputPath>C:\Temp\</OutputPath>

</settings>